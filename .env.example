# =============================================================================
# Mayan's Cake Factory — environment template
# Copy to backend/.env (and frontend/.env) and fill in. NEVER commit real values.
# Validate with: bash scripts/validate_environment.sh
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | production
APP_NAME=Mayan's Cake Factory
SECRET_KEY=                         # 64 hex chars: python -c "import secrets;print(secrets.token_hex(32))"
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
PORT=                               # injected by Railway at runtime; leave blank locally

# --- Supabase ------------------------------------------------------------
# Dev and production MUST use different projects. Never put the service-role
# key in the frontend or in any browser-delivered file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # BACKEND ONLY
SUPABASE_JWT_SECRET=                # verifies admin JWTs issued by Supabase Auth

# --- AI providers --------------------------------------------------------
AI_MODE=mock                        # mock | live   (mock needs no credentials)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Maps ----------------------------------------------------------------
MAPS_PROVIDER=mock                  # mock | google   (mock = Paris postal-code centroids)
MAPS_API_KEY=

# --- Bakery ----------------------------------------------------------------
# Never hard-code these in application code (spec §28).
BAKERY_NAME=Mayan's Cake Factory
BAKERY_ADDRESS=
BAKERY_LATITUDE=48.8584
BAKERY_LONGITUDE=2.2945

# --- Business defaults (DB settings table overrides these at runtime) -----
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Europe/Paris
DESIGN_LINK_EXPIRATION_DAYS=14
MAX_DESIGN_REVISIONS=3
DEFAULT_LEAD_TIME_HOURS=48
RUSH_THRESHOLD_HOURS=48
MIN_LEAD_TIME_HOURS=24
DAILY_PRODUCTION_POINTS=10
MAX_ORDERS_PER_DAY=6
AUTO_APPROVAL_PRICE_LIMIT_CENTS=150000

# --- Abuse protection ----------------------------------------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_GENERATIONS_PER_HOUR=10
MAX_UPLOAD_BYTES=5242880
